# Copy to .env. The defaults run everything offline, so nothing here is required.

# fake needs no AWS account. bedrock uses the default AWS credential chain.
LLM_MODE=fake
# Cross-region inference profile ids, from the Amazon Bedrock model cards.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5-5
BEDROCK_WORKER_MODEL_ID=us.anthropic.claude-haiku-5-5
AWS_REGION=us-east-1

# demo replays examples/demo_tickets.json and records write-backs under DATA_DIR.
TICKET_SOURCE=demo
# GITHUB_REPO=owner/repo
# GITHUB_TOKEN=
# Only ingest issues with this label. Recommended on public repositories.
# GITHUB_LABEL_FILTER=agent-triage

# JSON object of reviewer name to token. Unset means no login: reviewers type their own name,
# so "who" in the audit log is self-reported. Set this anywhere but your own machine.
# REVIEWER_TOKENS={"alice":"a-long-random-token"}
# How often to poll for tickets, in seconds. 0 means only when someone asks.
# POLL_INTERVAL_SECONDS=0

# SQLite cannot use WAL on a network file system. The deployed stack sets DELETE.
# SQLITE_JOURNAL_MODE=WAL

# The checkout the investigator reads. Defaults to examples/demo-target.
# TARGET_REPO_PATH=/path/to/checkout

# The Jira adapter is off by default and has never been run against a live server.
# JIRA_ENABLED=false
# JIRA_BASE_URL=https://example.atlassian.net
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# JIRA_JQL=project = SHOP AND statusCategory != Done
